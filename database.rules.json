{
  "rules": {
    ".read": false,
    ".write": false,
    "mareCerta": {
      "profiles": {
        ".read": true,
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && newData.exists()",
          ".validate": "newData.hasChildren(['displayName', 'createdAt'])",
          "displayName": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 40" },
          "createdAt": { ".validate": "newData.isNumber() && newData.val() <= now && (!data.exists() || newData.val() === data.val())" },
          "$other": { ".validate": false }
        }
      },
      "captures": {
        ".read": true,
        ".indexOn": ["createdAt", "uid"],
        "$id": {
          ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid && root.child('mareCerta/profiles').child(auth.uid).exists()) || (data.exists() && data.child('uid').val() === auth.uid && !newData.exists()))",
          ".validate": "newData.hasChildren(['uid','species','quantity','weight','date','location','createdAt'])",
          "uid": { ".validate": "newData.isString() && newData.val() === auth.uid" },
          "species": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 60" },
          "quantity": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000 && newData.val() % 1 === 0" },
          "weight": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
          "date": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
          "location": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 100" },
          "createdAt": { ".validate": "newData.isNumber() && newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
